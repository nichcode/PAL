BasedOnStyle: LLVM # use LLVM defaults

IndentWidth: 4
ColumnLimit: 100
UseTab: Never
UseCRLF: false
LineEnding: LF

AllowShortFunctionsOnASingleLine: None
AllowShortBlocksOnASingleLine: Never
AllowShortIfStatementsOnASingleLine: Never
AllowShortLambdasOnASingleLine: None
AllowShortEnumsOnASingleLine: false
AllowShortLoopsOnASingleLine: false

BinPackParameters: AlwaysOnePerLine
AllowAllParametersOfDeclarationOnNextLine: false
BinPackArguments: false
AllowAllArgumentsOnNextLine: false

BreakAfterOpenBracketFunction: true
BreakBeforeCloseBracketFunction: false
BreakAfterOpenBracketBracedList: true
BreakBeforeCloseBracketBracedList: true

PointerAlignment: Left
BreakBeforeBraces: Custom
IndentCaseLabels: true

BraceWrapping:
  AfterCaseLabel: false
  AfterControlStatement: Never
  AfterEnum: false
  AfterFunction: true
  AfterStruct: false
  AfterUnion: false
  AfterExternBlock: false
  BeforeCatch: false
  BeforeElse: false
  BeforeLambdaBody: false
  BeforeWhile: false
  IndentBraces: false
  SplitEmptyFunction: true
  SplitEmptyRecord: true